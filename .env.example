# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (Docker): docker run --name cashly-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ── Better Auth ───────────────────────────────────────────────────────────────
# Generate a strong secret:  npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=<paste a random 32-byte secret>
# The base URL Better Auth sees. In dev this is your local server; in prod set
# it to the public https URL of the deployed app (used for OAuth redirects).
BETTER_AUTH_URL=http://localhost:3000

# ── OAuth — Google ────────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials → OAuth client ID
# Authorized redirect URI:  {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth — Apple ─────────────────────────────────────────────────────────────
# Requires paid Apple Developer account. https://developer.apple.com/account
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/apple
# APPLE_CLIENT_SECRET must be a JWT generated from your Apple private key (.p8).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_ID=

# ── OAuth — Discord ───────────────────────────────────────────────────────────
# https://discord.com/developers/applications → New Application → OAuth2
# Add redirect URL: {BETTER_AUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Email verification (Resend) ───────────────────────────────────────────────
# Get a key at https://resend.com (free tier). If unset, verification links are
# logged to the server console (dev mode only).
RESEND_API_KEY=
EMAIL_FROM="Cashly <onboarding@resend.dev>"
# Set to "true" to block sign-in until the user has verified their email.
REQUIRE_EMAIL_VERIFICATION=false

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Admin credentials — ALL THREE must be set in production or admin panel is disabled
ADMIN_TOKEN=<generate a strong random secret, e.g. openssl rand -hex 32>
ADMIN_USERNAME=<your admin username>
ADMIN_PASSWORD=<your admin password>

# CORS + Better Auth trustedOrigins — comma-separated list of allowed browser origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── AI (optional) ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
