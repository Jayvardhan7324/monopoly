# ── Supabase (local — run: supabase start to get these values) ────────────────
# Server-side (secret — never expose to browser)
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=<paste service_role key from `supabase start` output>

# Client-side (public — safe to expose, used by Vite)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=<paste anon key from `supabase start` output>

# ── Database (Supabase local Postgres on port 54322) ──────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ── OAuth — Google ────────────────────────────────────────────────────────────
# Configure in Supabase dashboard → Authentication → Providers → Google
# Callback URL: http://localhost:54321/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Admin credentials — ALL THREE must be set in production or admin panel is disabled
ADMIN_TOKEN=<generate a strong random secret, e.g. openssl rand -hex 32>
ADMIN_USERNAME=<your admin username>
ADMIN_PASSWORD=<your admin password>

ALLOWED_ORIGINS=http://localhost:3000

# ── AI (optional) ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
