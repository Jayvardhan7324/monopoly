# ── Database ──────────────────────────────────────────────────────────────────
# Get from Neon (neon.tech), Supabase, or any Postgres provider
DATABASE_URL=postgresql://user:password@localhost:5432/richup

# ── Better Auth ───────────────────────────────────────────────────────────────
# Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=your-random-secret-here

# ── OAuth — Google ────────────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth — Apple ─────────────────────────────────────────────────────────────
# https://developer.apple.com → Certificates, Identifiers & Profiles
# Callback URL: http://localhost:3000/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
ADMIN_TOKEN=richup-admin-2025
ALLOWED_ORIGINS=http://localhost:3000

# ── AI (optional) ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
